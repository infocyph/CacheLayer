{
    "name": "infocyph/cachelayer-release-psr-consumer",
    "type": "project",
    "require": {
        "php": "^8.4 || ^8.5",
        "cache/integration-tests": "^1.0",
        "infocyph/cachelayer": "4.0.x-dev",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": false,
                "versions": {
                    "infocyph/cachelayer": "4.0.x-dev"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "CacheLayerRelease\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": false
        },
        "sort-packages": true
    }
}
