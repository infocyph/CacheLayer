        - phar://%rootDir%/phpstan.phar/stubs/ReflectionMethod.stub
        - phar://%rootDir%/phpstan.phar/stubs/ReflectionParameter.stub
        - phar://%rootDir%/phpstan.phar/stubs/ReflectionProperty.stub
        - phar://%rootDir%/phpstan.phar/stubs/ReflectionType.stub
        - phar://%rootDir%/phpstan.phar/stubs/iterable.stub
        - phar://%rootDir%/phpstan.phar/stubs/ArrayObject.stub
        - phar://%rootDir%/phpstan.phar/stubs/WeakReference.stub
        - phar://%rootDir%/phpstan.phar/stubs/SensitiveParameterValue.stub
        - phar://%rootDir%/phpstan.phar/stubs/ImagickPixel.stub
        - phar://%rootDir%/phpstan.phar/stubs/PDOStatement.stub
        - phar://%rootDir%/phpstan.phar/stubs/date.stub
        - phar://%rootDir%/phpstan.phar/stubs/ibm_db2.stub
        - phar://%rootDir%/phpstan.phar/stubs/mysqli.stub
        - phar://%rootDir%/phpstan.phar/stubs/zip.stub
        - phar://%rootDir%/phpstan.phar/stubs/dom.stub
        - phar://%rootDir%/phpstan.phar/stubs/spl.stub
        - phar://%rootDir%/phpstan.phar/stubs/SplObjectStorage.stub
        - phar://%rootDir%/phpstan.phar/stubs/Exception.stub
        - phar://%rootDir%/phpstan.phar/stubs/arrayFunctions.stub
        - phar://%rootDir%/phpstan.phar/stubs/core.stub
        - phar://%rootDir%/phpstan.phar/stubs/typeCheckingFunctions.stub
        - phar://%rootDir%/phpstan.phar/stubs/Countable.stub
