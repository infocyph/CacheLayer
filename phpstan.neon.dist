includes:
    - vendor/infocyph/phpforge/resources/phpstan.neon.dist

parameters:
    # Replace the built-in Memcached stub, retaining every other upstream 2.3 stub.
    stubFiles!:
        - qa/stubs/memcached.stub
        - phar://%rootDir%/phpstan.phar/stubs/Redis.stub
        - phar://%rootDir%/phpstan.phar/stubs/ReflectionAttribute.stub
        - phar://%rootDir%/phpstan.phar/stubs/ReflectionClassConstant.stub
